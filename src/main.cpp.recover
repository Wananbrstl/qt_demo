#include "domain/Types.h"
#include "ui/MainWindow.h"

#include <QApplication>
#include <QCoreApplication>

int main(int argc, char* argv[]) {
    // Qt 5 requires the high-DPI policies to be selected before QApplication
    // construction. Qt 6 enables equivalent behavior by default.
    QCoreApplication::setAttribute(Qt::AA_EnableHighDpiScaling);
    QCoreApplication::setAttribute(Qt::AA_UseHighDpiPixmaps);

    // Stable metadata gives QSettings deterministic paths.
    QCoreApplication::setOrganizationName(QStringLiteral("DeviceStudioLearning"));
    QCoreApplication::setApplicationName(QStringLiteral("DeviceStudio"));
    QCoreApplication::setApplicationVersion(QStringLiteral("0.1.0"));

    QApplication application(argc, argv);
    ds::domain::registerMetaTypes();

    ds::ui::MainWindow window;
    window.show();
    return application.exec();
}
