#include "infrastructure/DatabaseSession.h"
#include "infrastructure/MigrationRunner.h"
#include "repositories/HistorianRepository.h"
#include "schema/HistorianSchema.h"

#include <QDateTime>
#include <QProcessEnvironment>
#include <QSqlError>
#include <QSqlQuery>
#include <QTest>
#include <QUuid>

using namespace ds::database;

class MysqlContractTest final : public QObject {
    Q_OBJECT

private slots:
    void migrationsAndIdempotentTelemetryWrite();
};

void MysqlContractTest::migrationsAndIdempotentTelemetryWrite() {
    if (qEnvironmentVariable("DEVICESTUDIO_RUN_MYSQL_TESTS") != QStringLiteral("1")) {
        QSKIP("set DEVICESTUDIO_RUN_MYSQL_TESTS=1 to run against an isolated MySQL schema");
    }
    QVERIFY2(QSqlDatabase::isDriverAvailable(QStringLiteral("QMYSQL")),
             "Qt QMYSQL driver is unavailable");

    const QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
    MysqlConfig config;
    config.enabled = true;
    config.host = environment.value(QStringLiteral("DEVICESTUDIO_MYSQL_HOST"),
                                    QStringLiteral("127.0.0.1"));
    config.database = environment.value(QStringLiteral("DEVICESTUDIO_MYSQL_DATABASE"),
                                        QStringLiteral("device_history"));
    config.user = environment.value(QStringLiteral("DEVICESTUDIO_MYSQL_USER"),
                                    QStringLiteral("device_app"));
    bool portOk = false;
    const int port = environment.value(QStringLiteral("DEVICESTUDIO_MYSQL_PORT"),
                                       QStringLiteral("3306")).toInt(&portOk);
    QVERIFY2(portOk && port > 0 && port <= 65535, "invalid MySQL port environment value");
    config.port = static_cast<quint16>(port);

    DatabaseSession session(DatabaseBackend::MySQL, QStringLiteral("contract-test"));
    OperationResult result = session.open(config);
    QVERIFY2(result.succeeded(), qPrintable(result.error.diagnosticText()));
    result = MigrationRunner::apply(session, HistorianSchema::mysqlMigrations());
    QVERIFY2(result.succeeded(), qPrintable(result.error.diagnosticText()));

    const qint64 now = QDateTime::currentMSecsSinceEpoch();
    const QString deviceId = QStringLiteral("contract-%1")
                                 .arg(QUuid::createUuid().toString(QUuid::WithoutBraces));
    const TelemetryRecord record{QUuid::createUuid().toRfc4122(), deviceId,
                                 QStringLiteral("MySQL contract fixture"), now, now,
                                 41.5, 2400.0, 1.3, 63.0, 0};
    HistorianRepository repository(session);
    QVERIFY(repository.persistCentralBatch({record}).succeeded());
    QVERIFY(repository.persistCentralBatch({record}).succeeded());

    QSqlQuery count(session.database());
    count.prepare(QStringLiteral(
        "SELECT COUNT(*) FROM telemetry_samples WHERE event_id=?"));
    count.addBindValue(record.eventId);
    QVERIFY2(count.exec(), qPrintable(count.lastError().text()));
    QVERIFY(count.next());
    QCOMPARE(count.value(0).toInt(), 1);

    // Cleanup targets only the UUID generated by this test. The queried result
    // has already proved that replay is idempotent.
    QSqlQuery cleanup(session.database());
    cleanup.prepare(QStringLiteral("DELETE FROM telemetry_samples WHERE event_id=?"));
    cleanup.addBindValue(record.eventId);
    QVERIFY(cleanup.exec());
    cleanup.prepare(QStringLiteral("DELETE FROM devices WHERE device_id=?"));
    cleanup.addBindValue(deviceId);
    QVERIFY(cleanup.exec());
    session.close();
}

QTEST_APPLESS_MAIN(MysqlContractTest)
#include "test_mysql_contract.moc"
