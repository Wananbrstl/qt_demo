#pragma once

#include "domain/Types.h"

#include <QAbstractItemModel>
#include <QVector>

namespace ds::ui {

struct DeviceListEntry final {
    domain::DeviceId id;
    QString displayName;
    domain::DeviceEndpoint endpoint;
    domain::DeviceState state{domain::DeviceState::Disconnected};
};

class DeviceTreeModel final : public QAbstractItemModel {
    Q_OBJECT

public:
    enum Column { NameColumn, StateColumn, ColumnCount };
    enum Role { DeviceIdRole = Qt::UserRole + 1, HostRole, PortRole, StateRole };

    explicit DeviceTreeModel(QObject* parent = nullptr);

    QModelIndex index(int row, int column,
                      const QModelIndex& parent = {}) const override;
    QModelIndex parent(const QModelIndex& child) const override;
    int rowCount(const QModelIndex& parent = {}) const override;
    int columnCount(const QModelIndex& parent = {}) const override;
    QVariant data(const QModelIndex& index, int role) const override;
    QVariant headerData(int section, Qt::Orientation orientation,
                        int role) const override;

    void setDevices(QVector<DeviceListEntry> devices);
    void updateState(const domain::DeviceId& id, domain::DeviceState state);
    [[nodiscard]] const DeviceListEntry* deviceAt(const QModelIndex& index) const;

private:
    QVector<DeviceListEntry> devices_;
};

}  // namespace ds::ui
